# Copy this file to .env and fill in real values. Never commit the real .env
# (it's already gitignored). See pulsewatch_backend/ARCHITECTURE.md for the
# full explanation of each variable and the one-time Gmail OAuth setup steps.

# --- Core (required for a stable production deployment) ---
# Signs JWT auth tokens and Flask sessions. If unset, a random key is
# generated on every restart (fine for quick local testing, but it
# invalidates all logins/tokens each time the process restarts).
SECRET_KEY=replace-with-a-long-random-string

# Public base URL the backend considers itself served at.
PUBLIC_SERVER_URL=https://pulsana.org

# Set to 1 to enable Flask debug mode locally. Never set this in production.
FLASK_DEBUG=0

# --- Contact form -> email (optional; /contact still renders without these,
# it just fails to actually send) ---
# Gmail address the contact form sends from/to, authenticated via OAuth
# (not a password/App Password).
CONTACT_SMTP_USERNAME=your-gmail-address@gmail.com
# Defaults to CONTACT_SMTP_USERNAME if left unset.
CONTACT_EMAIL_TO=

# OAuth client from Google Cloud Console (Gmail API enabled, OAuth consent
# screen configured, redirect URI https://<your-domain>/researcher/gmail-oauth/callback).
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Obtained by visiting /researcher/gmail-oauth/start once the client id/secret
# above are set — see ARCHITECTURE.md for the full walkthrough.
GMAIL_OAUTH_REFRESH_TOKEN=
